<div class="sandev-captcha">

    <!-- BARIS IMAGE + REFRESH -->
    <div class="sandev-captcha-top">
        <img src="@ImageBase64" alt="captcha" style="height:@($"{Height}px")" />

        <button type="button" class="refresh-btn" style="height:@($"{Height}px")" @onclick="@RefreshCaptcha">
            <i class="fa-solid fa-rotate-right"></i>
        </button>
    </div>

    <!-- INPUT -->
    <div class="sandev-input-wrapper">
        <i class="fa-solid fa-shield-keyhole sandev-input-icon"></i>
        <input class="sandev-input" @bind="Value" />
    </div>

</div>

@code {
    [Inject] ICaptchaService CaptchaService { get; set; }

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    // 🔥 CONFIG LANGSUNG DI COMPONENT
    [Parameter] public int Length { get; set; } = 5;
    [Parameter] public int MaxLength { get; set; } = 10;
    [Parameter] public int MaxSpecialChars { get; set; } = 5;

    [Parameter] public int WidthPerChar { get; set; } = 30;
    [Parameter] public int Height { get; set; } = 60;

    [Parameter] public float WaveAmplitude { get; set; } = 5f;
    [Parameter] public float WaveFrequency { get; set; } = 0.05f;

    [Parameter] public int NoiseLines { get; set; } = 3;
    [Parameter] public int NoiseDots { get; set; } = 100;

    [Parameter] public float BlurRadius { get; set; } = 0f;

    private string? _key;
    private string? ImageBase64;

    private string HeightPx => $"{Height}px";

    protected override void OnInitialized()
    {
        Generate();
    }

    private void Generate()
    {
        var result = CaptchaService.Generate(new CaptchaRequest
        {
            Length = Length,
            MaxLength = MaxLength,
            MaxSpecialChars = MaxSpecialChars,
            WidthPerChar = WidthPerChar,
            Height = Height,
            WaveAmplitude = WaveAmplitude,
            WaveFrequency = WaveFrequency,
            NoiseLines = NoiseLines,
            NoiseDots = NoiseDots,
            BlurRadius = BlurRadius
        });

        _key = result.Key;
        ImageBase64 = result.Base64Image;
        Value = null;
    }

    private void RefreshCaptcha()
    {
        Generate();
    }

    public bool Validate()
    {
        if (string.IsNullOrEmpty(_key) || string.IsNullOrEmpty(Value))
            return false;

        return CaptchaService.ValidateCaptcha(_key, Value);
    }
}
