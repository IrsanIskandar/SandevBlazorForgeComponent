@using SandevBlazorComponent.Infrastructure.EnumClass

@typeparam T

<div class="ipe-wrapper @(LabelPosition == LabelPosition.Left ? "left" : "top") @(FloatLabel ? "float" : "")"
     @ref="WrapperRef">

    @if (!FloatLabel && !string.IsNullOrEmpty(Label))
    {
        <label class="ipe-label">
            @Label
            @if (Required)
            {
                <span class="ipe-text-danger">*</span>
            }
        </label>
    }

    <div class="ipe-field @(IsEditing || !string.IsNullOrEmpty(Value?.ToString()) ? "active" : "")">

        @if (FloatLabel && !string.IsNullOrEmpty(Label))
        {
            <label class="ipe-floating-label @(IsEditing || !string.IsNullOrEmpty(DisplayValue) ? "active" : "")">
                @Label
                @if (Required)
                {
                    <span class="ipe-text-danger">*</span>
                }
            </label>
        }

        @if (!IsEditing)
        {
            <div class="ipe-display"
                 tabindex="0"
                 role="button"
                 @onclick="HandleClick"
                 @ondblclick="HandleDoubleClick">

                @(string.IsNullOrWhiteSpace(DisplayValue)
                    ? EmptyText
                    : DisplayValue)

            </div>
        }
        else
        {
            <!-- 🔥 EDITOR (INLINE / POPUP) -->
            <div class="ipe-editor @(Mode == EditorMode.Popup ? "popup" : "inline")"
                 @ref="EditorRef"
                 tabindex="-1">

                @if (EditorTemplate != null)
                {
                    @EditorTemplate(CurrentValue)
                }
                else
                {
                    @RenderEditor()
                }

                @if (ShowButtons)
                {
                    <div class="ipe-actions">
                        <button type="button" @onclick="Save">✔</button>
                        <button type="button" @onclick="Cancel">✖</button>
                    </div>
                }
            </div>
        }

    </div>

</div>

@code {

}
