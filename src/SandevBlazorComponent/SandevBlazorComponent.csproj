<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<!-- ======================== -->
		<!--     Package Identity     -->
		<!-- ======================== -->
		<AssemblyName>SandevBlazorComponent</AssemblyName>
		<PackageId>SandevBlazorComponent</PackageId>
		<Version>0.0.5</Version>
		<AssemblyVersion>0.0.5</AssemblyVersion>
		<FileVersion>0.0.5</FileVersion>
		<Authors>Sandev</Authors>
		<Company>Sandev Corp.</Company>
		<Owners>Sandev</Owners>
		<Copyright>Copyright © $([System.DateTime]::Now.Year) Sandev</Copyright>

		<!-- ======================== -->
		<!--     Package Metadata     -->
		<!-- ======================== -->
		<Title>Sandev BlazorForge Components</Title>
		<Description>
			SandevBlazorComponent is a modern, lightweight Blazor component library designed for rapid UI development. Supports Blazor WebAssembly and Blazor Server.
		</Description>
		<Summary>A modern, lightweight Blazor UI component library for WebAssembly and Server.</Summary>
		<Tags>blazor;components;ui;webassembly;blazor-server;dotnet;razor</Tags>
		<PackageProjectUrl>https://github.com/IrsanIskandar/SandevBlazorForgeComponent</PackageProjectUrl>
		<RepositoryUrl>https://github.com/IrsanIskandar/SandevBlazorForgeComponent</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!--<PackageIcon>icon.png</PackageIcon>-->
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>Initial release of SandevBlazorComponent v0.0.5</PackageReleaseNotes>

		<!-- ======================== -->
		<!--     Build Settings       -->
		<!-- ======================== -->
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>

		<!-- Generate XML documentation for IntelliSense -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>

		<!-- NuGet pack settings -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedAllSources>true</EmbedAllSources>

		<RazorLangVersion>latest</RazorLangVersion>
	</PropertyGroup>

	<!-- Include README and icon in the NuGet package -->
	<!-- README.md dan icon.png berada di root repo (satu level di atas folder src/) -->
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<!--<None Include="icon.png" Pack="true" PackagePath="\" Condition="Exists('icon.png')" />-->
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.7" />
	  <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.7" />
	  <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
	  <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
	  <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.*" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.*" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.*" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\font-awesome\" />
	</ItemGroup>

	<ItemGroup>
	  <Content Update="wwwroot\css\sandev-blazor.css">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Update="wwwroot\js\sandev-blazor.js">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Update="wwwroot\js\sandev-loader.js">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Update="wwwroot\js\viewer-and-editor\inplace-editor.js">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

</Project>
