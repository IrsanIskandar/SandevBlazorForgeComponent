@page "/"
@rendermode InteractiveServer

@using SandevBlazorComponent.Components.Layout
@using SandevBlazorComponent.Components.ViewerAndEditor

<PageTitle>Home</PageTitle>

<h1>Welcome to Sandev Blazor Component!</h1>

<InPlaceEditor T="string"
    EditableOn="EditableOn.Click"
    LabelPosition="LabelPosition.Left"
    FloatLabel="false"
    Label="Demo In Place Editor"
    Required="true"
    Mode="EditorMode.Inline"
    ShowButtons="true"
    EditorType="EditorType.Text"
    @bind-Value="defaultValue">
</InPlaceEditor>
<br />
<br />
<CaptchaImage Length="8"
              MaxLength="10"
              MaxSpecialChars="3"
              BlurRadius="1.2f"
              WaveAmplitude="2"
              NoiseDots="120" 
              WaveFrequency="0.5f" />

<button @onclick="SubmitCaptchaImage">Submit</button>
<br />
<br />
<MathCaptcha @ref="mathCaptcha" />

<button @onclick="SubmitMathCaptcha">Submit</button>
<br />
<br />
<SandevTextbox Placeholder="Username" Icon="fa-solid fa-user" Color="ColorVariant.Orange" />

<SandevTextbox Placeholder="Password" Icon="fa-solid fa-lock" Color="ColorVariant.Teal" Variant="InputVariant.Filled" />

<SandevTextbox Placeholder="Email" Variant="InputVariant.Underline" Size="ItemSize.Lg" />

<SandevTextbox Placeholder="Error state" IsError="true" />

<SandevTextbox Placeholder="Success state" IsSuccess="true" />

<SandevTextbox Label="Email"
               Type="InputType.Email"
               PrefixIcon="fa-solid fa-envelope"
               Color="ColorVariant.Sky"
               Clearable="true" />

<SandevTextbox Label="Password"
               Type="InputType.Password"
               PrefixIcon="fa-solid fa-lock"
               EnablePasswordToggle="true"
               Color="ColorVariant.Violet" />

<SandevTextbox Label="Username"
               PrefixIcon="fa-solid fa-user"
               Color="ColorVariant.Emerald" />

<SandevTextbox Label="Soft Pink" Color="ColorVariant.Rose" />

<br />
<br />
<SandevFormControl Label="Username" Helper="Masukkan username anda">
    <SandevTextbox Icon="fa-solid fa-user" />
</SandevFormControl>

<SandevFormControl Label="Email" Error="Email tidak valid">
    <SandevTextbox Icon="fa-solid fa-envelope" IsError="true" />
</SandevFormControl>

<button @onclick="SubmitMathCaptcha">Submit</button>
<br />
<br />
<SandevThemeToggle />



@code {
    private string defaultValue = "";

    private CaptchaImage imageCaptcha;
    private MathCaptcha mathCaptcha;

    private void SubmitCaptchaImage()
    {
        if (!imageCaptcha.Validate())
        {
            Console.WriteLine("Captcha salah ❌");
            return;
        }

        Console.WriteLine("Captcha benar ✅");
    }

    private void SubmitMathCaptcha()
    {
        if (!mathCaptcha.Validate())
        {
            Console.WriteLine("Math captcha salah ❌");
            return;
        }

        Console.WriteLine("Valid ✅");
    }
}
